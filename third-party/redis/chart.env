# Chart coordinates for the third-party lane. scripts/validate.sh (and CI) read
# every third-party/*/chart.env, `helm template` the chart with the sibling
# values.yaml, and run the golden-registry image gate on the rendered output.
# Keep in sync with platform/argocd/applications/thirdparty-<name>.yaml.
CHART_REPO=https://charts.bitnami.com/bitnami
CHART_NAME=redis
CHART_VERSION=20.5.0
RELEASE=redis
NAMESPACE=demo-dev
